{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/mariachi", "destination": "/mariachi/index.html" },
    { "source": "/nortena", "destination": "/nortena/index.html" },
    { "source": "/banda", "destination": "/banda/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/serenatas", "destination": "/serenatas/index.html" },
    { "source": "/eventos-corporativos", "destination": "/eventos-corporativos/index.html" },
    { "source": "/bodas", "destination": "/bodas/index.html" },
    { "source": "/cumpleanos", "destination": "/cumpleanos/index.html" },
    { "source": "/serenata-mama", "destination": "/serenata-mama/index.html" },
    { "source": "/((?!api/|_next/|images/|video/|fonts/|assets/|favicon|robots\\.txt|sitemap\\.xml|mariachi/|nortena/|banda/|faq/|serenatas/|eventos-corporativos/|bodas/|cumpleanos/|serenata-mama/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
